# 生产环境配置 / Production Environment Configuration
# 复制此文件为 .env 并根据生产环境需求修改
# Copy this file to .env and modify according to production requirements

# 部署环境 / Deployment Environment
DEPLOYMENT_ENV=production

# AWS配置 / AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# 应用配置 / Application Configuration
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8080

# 性能配置 / Performance Configuration
MAX_WORKERS=4
CONCURRENT_LIMIT=10
CACHE_TTL=3600

# 安全配置 / Security Configuration
ENABLE_INPUT_VALIDATION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=100
MAX_MESSAGE_LENGTH=2000

# 数据管理配置 / Data Management Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_INTERVAL_HOURS=24
MAX_BACKUP_FILES=7

# 监控配置 / Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# 交互式优化配置 / Interactive Refinement Configuration
MAX_SESSIONS_PER_USER=5
SESSION_TIMEOUT=3600
MAX_MESSAGES_PER_SESSION=100
MAX_VERSIONS_PER_SESSION=50

# 个性化学习配置 / Personalization Configuration
ENABLE_PREFERENCE_LEARNING=true
MIN_INTERACTIONS_FOR_LEARNING=5
MAX_PERSONALIZED_PROMPTS=20